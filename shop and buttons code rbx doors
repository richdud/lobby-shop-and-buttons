local player=game:GetService("Players").LocalPlayer
local pg=player:WaitForChild("PlayerGui")
local queued=false

local function setup()
	local global=pg:FindFirstChild("GlobalUI")
	local main=pg:FindFirstChild("MainUI")
	if not global or not main then return end

	local s=global:FindFirstChild("Shop")
	local lobby=main:FindFirstChild("LobbyFrame")
	if not s or not lobby then return end

	local x=s:FindFirstChild("ScrollingShop")
	local buttons=s:FindFirstChild("Buttons")
	local b=buttons and buttons:FindFirstChild("Skips")
	local bottom=lobby:FindFirstChild("BottomButtons")
	local side=lobby:FindFirstChild("SideButtons")
	if not x or not b or not bottom or not side then return end

	local function show(p,n)
		local v=p:FindFirstChild(n)
		if v then v.Visible=true end
	end

	show(x,"Collab")
	show(x,"Promo")
	show(x,"AdminPanel")
	show(x,"GiftAdminPanel")
	show(x,"Seasonal")

	if x.Collab then show(x.Collab,"FinalReward") end
	if x.Promo then show(x.Promo,"WPromo") end
	if x.Seasonal then
		show(x.Seasonal,"FinalReward")
		show(x.Seasonal,"FinalRewardOut")
	end

	local tot=x:FindFirstChild("_TrickOrTreatSeasonal")
	if tot then
		tot.Visible=true
		show(tot,"FinalReward")
		show(tot,"FinalRewardOut")
	end

	local knobs=x:FindFirstChild("Knobs")
	if knobs then
		show(knobs,"7")
		show(knobs,"8")
	end

	show(b,"Seasonal")
	show(b,"Collab")

	bottom.Visible=true
	show(bottom,"ButtonCollab")
	side.Visible=true

	local function hook(button,gui)
		if not button then return end
		button.Visible=true

		local function connect(v)
			if v:GetAttribute("GuiHooked") then return end
			v:SetAttribute("GuiHooked",true)
			v.Activated:Connect(function()
				local g=lobby:FindFirstChild(gui)
				if g then g.Visible=not g.Visible end
			end)
		end

		if button:IsA("GuiButton") then
			connect(button)
		else
			for _,v in ipairs(button:GetDescendants()) do
				if v:IsA("GuiButton") then connect(v) end
			end
		end
	end

	hook(bottom:FindFirstChild("ButtonVoiceChat"),"VoiceChat")
	hook(side:FindFirstChild("ButtonVoiceChat"),"VoiceChat")
	hook(side:FindFirstChild("ButtonShop"),"ShopOld")
	hook(side:FindFirstChild("ButtonSettings"),"SettingsOld")
	hook(side:FindFirstChild("ButtonCredits"),"CreditsScreenOld")

	local function closeHook(n)
		local menu=lobby:FindFirstChild(n)
		if not menu then return end
		local close=menu:FindFirstChild("CloseButton",true)
		if close and close:IsA("GuiButton") and not close:GetAttribute("CloseHooked") then
			close:SetAttribute("CloseHooked",true)
			close.Activated:Connect(function()
				menu.Visible=false
			end)
		end
	end

	closeHook("ShopOld")
	closeHook("SettingsOld")
	closeHook("VoiceChat")
end

local function queue()
	if queued then return end
	queued=true
	task.delay(.2,function()
		queued=false
		setup()
	end)
end

setup()
pg.DescendantAdded:Connect(queue)
